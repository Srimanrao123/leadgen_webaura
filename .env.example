# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored. Never commit it.

# Supabase -> Project Settings -> API Keys / Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_...) or, on older projects, the "anon public" key.
# Never put the secret / service_role key here or anywhere in this repo.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Your own CRM login email (the admin creates it in Supabase -> Authentication -> Users).
# The password is never stored: `python3 scripts/crm.py login` asks for it.
CRM_EMAIL=you@example.com
